generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
  MANAGER
  USER
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  role       Role     @default(USER)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clients    Client[] @relation("UserClients")

  @@map("users")
}

model Client {
  id              String   @id @default(uuid()) @db.Uuid
  client_code     String   @db.VarChar(255)
  client_name     String   @db.VarChar(255)
  document        String   @db.VarChar(255)
  email           String   @unique @db.VarChar(255)
  job_codes       String   @db.VarChar(255)
  new_format_flag Boolean
  created_by      String   @db.Uuid
  is_active       Boolean  @default(true)
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  creator         User     @relation("UserClients", fields: [created_by], references: [id])
  budgets         Budget[]
  rule_templates  RuleTemplate[]

  @@map("clients")
}

model Area {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  roles      RoleType[]
  
  @@map("areas")
}

model RoleType {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(255)
  area_id    String   @db.Uuid
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  area       Area     @relation(fields: [area_id], references: [id])
  budget_roles BudgetRole[]

  @@map("role_types")
}

model VerbaGroup {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(255) 
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  verba_types VerbaType[]

  @@map("verba_groups")
}

model VerbaType {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(255) 
  group_id   String   @db.Uuid
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group      VerbaGroup @relation(fields: [group_id], references: [id])
  budget_verbas BudgetVerba[]
  rule_templates RuleTemplate[]

  @@map("verba_types")
}

model RuleTemplate {
  id            String    @id @default(uuid()) @db.Uuid
  client_id     String?   @db.Uuid 
  state_uf      String?   @db.VarChar(2) 
  verba_type_id String    @db.Uuid
  calc_type     String    @default("FIXED") 
  value         Decimal   @default(0.0) @db.Decimal(10, 2)
  text_value    String?   @db.Text
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  client        Client?   @relation(fields: [client_id], references: [id])
  verba_type    VerbaType @relation(fields: [verba_type_id], references: [id])

  @@map("rule_templates")
}

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  client_id   String   @db.Uuid
  status      String   @default("DRAFT") 
  dates       String?  @db.VarChar(255)
  total       Decimal  @default(0.0) @db.Decimal(10, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  client      Client   @relation(fields: [client_id], references: [id])
  roles       BudgetRole[]

  @@map("budgets")
}

model BudgetRole {
  id          String   @id @default(uuid()) @db.Uuid
  budget_id   String   @db.Uuid
  role_id     String   @db.Uuid
  state_uf    String   @db.VarChar(2) 
  headcount   Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  budget      Budget   @relation(fields: [budget_id], references: [id])
  role        RoleType @relation(fields: [role_id], references: [id])
  verbas      BudgetVerba[]

  @@map("budget_roles")
}

model BudgetVerba {
  id              String   @id @default(uuid()) @db.Uuid
  budget_role_id  String   @db.Uuid
  verba_type_id   String   @db.Uuid
  calc_type       String   @default("FIXED") 
  value           Decimal  @default(0.0) @db.Decimal(10, 2)
  text_value      String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  budget_role     BudgetRole @relation(fields: [budget_role_id], references: [id])
  verba_type      VerbaType  @relation(fields: [verba_type_id], references: [id])

  @@map("budget_verbas")
}

